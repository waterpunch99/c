{
  "resource_mode": "fixed-resource",
  "target_rate": 200,
  "kafka_partitions": 8,
  "operator_parallelism": {"source": 2, "parse": 2, "heavy": 2, "aggregation": 2, "sink": 2},
  "cpu_work_iterations": 5000,
  "keyed_cpu_work_iterations": 3000,
  "payload_size": 256,
  "number_of_users": 1000000,
  "distribution": "uniform",
  "hot_key_ratio": 0.4,
  "seed": 42,
  "partition_strategy": "round-robin",
  "producer_workers": 1,
  "state_backend": "hashmap",
  "max_parallelism": 128,
  "chaining": false,
  "checkpoint_interval_ms": 5000,
  "checkpoint_timeout_ms": 60000,
  "latency_sample_every": 10,
  "sample_interval_seconds": 5,
  "kafka_probe_attempts": 2,
  "preflight_seconds": 10,
  "warmup_seconds": 60,
  "measurement_seconds": 180,
  "drain_timeout_seconds": 60,
  "thresholds": {
    "producer_rate_tolerance": 0.02,
    "minimum_interval_rate_ratio": 0.95,
    "partition_max_mean_ratio": 1.1,
    "minimum_stability_seconds": 120,
    "minimum_samples": 6,
    "minimum_sample_coverage": 0.7,
    "maximum_metric_age_seconds": 3,
    "backlog_slope_records_per_second": 5,
    "backlog_delta_records": 100,
    "sink_produced_ratio": 0.98,
    "latency_p95_slope_ms_per_second": 5,
    "minimum_latency_samples": 100,
    "maximum_clock_uncertainty_ms": 500,
    "maximum_cpu_quota_utilization": 0.95,
    "maximum_throttled_period_ratio": 0.1
  }
}
